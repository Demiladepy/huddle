# ── Model provider ─────────────────────────────────────────────
# Set ONE of these. With none set, Huddle runs in offline mode:
# same runtime, events and tools, with heuristics instead of the model.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Optional override. Defaults to a model from whichever provider key is set.
# MODEL=gpt-5.4-mini
# MODEL=claude-sonnet-4-6
# MODEL=gemini-3.5-flash

# ── Space ──────────────────────────────────────────────────────
# SPACE_EMAIL=crew@huddle.space
# PORT=3000
# DATA_FILE=./data.json

# ── Mozaik cloud ───────────────────────────────────────────────
# Easiest: npm run pair  (approve in the browser; no key copy/paste).
# Or paste the key shown at https://app.jigjoy.ai:
# MOZAIK_API_KEY=pk_...
# MOZAIK_PROJECT_ID=prj_...

{
  "name": "huddle",
  "version": "1.0.0",
  "description": "One live page for your group, with its own inbox and a crew of Mozaik agents that file everything that lands in it.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Demiladepy/huddle.git"
  },
  "homepage": "https://github.com/Demiladepy/huddle#readme",
  "bugs": {
    "url": "https://github.com/Demiladepy/huddle/issues"
  },
  "author": "Demiladepy",
  "keywords": [
    "mozaik",
    "ai-agents",
    "multi-agent",
    "agentic-ai",
    "typescript",
    "express",
    "server-sent-events",
    "realtime",
    "hackathon"
  ],
  "scripts": {
    "start": "tsx server.ts",
    "dev": "tsx watch server.ts",
    "pair": "mozaik-cloud pair",
    "demo": "node scripts/demo.mjs",
    "shot": "node scripts/screenshot.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/huddle.test.mjs",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "@mozaik-ai/cloud-sdk": "^0.1.3",
    "@mozaik-ai/core": "^4.2.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
